QWidget {
    background-color: #f2f4f7;
    color: #1f2933;
    font-family: "Aptos", "Segoe UI", sans-serif;
    font-size: 10pt;
}

QMainWindow, #centralWorkspace { background-color: #e7ebf0; }
QMenuBar, QMenu, QToolBar, QStatusBar { background-color: #ffffff; color: #1f2933; }
QMenuBar::item:selected, QMenu::item:selected { background-color: #cfe0f5; }
QLineEdit, QPlainTextEdit, QListView, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    border: 1px solid #aeb8c2;
    selection-background-color: #2f6fad;
}
QPushButton { min-height: 28px; padding: 2px 8px; }
QGroupBox {
    border: 1px solid #aeb8c2;
    margin-top: 8px;
    font-weight: 600;
}
QGroupBox::title { color: #0b5da8; subcontrol-origin: margin; left: 8px; padding: 0 3px; }
#patientNameEditor { font-size: 15pt; font-weight: 700; }
#censusStatus { color: #60758a; }
QTabBar::tab:selected { font-weight: 700; color: #004f91; }
#patientHeader { font-size: 17pt; font-weight: 700; color: #172b3a; }
#popupPatientHeader { font-size: 17pt; font-weight: 700; color: #172b3a; }
#runningProblemList { background-color: #ffffff; }
#taskBoardGuidance { color: #60758a; }
#mainWindow QPushButton { min-height: 24px; }
